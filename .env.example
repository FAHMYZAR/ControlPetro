# ControlPetro — contoh konfigurasi.
# Cara pakai: salin file ini menjadi `.env` (atau `bridge/.env` di setup lama),
# isi nilainya, lalu restart server. File `.env` yang asli JANGAN di-commit.
#
#   cp .env.example .env
#
# Password login dashboard. Isi sendiri, minimal 8 karakter.
# Kalau dikosongkan, server akan membuat password acak otomatis
# dan menyimpannya ke file .env saat pertama kali jalan.
BRIDGE_PASSWORD=

# Username login dashboard (opsional, default: admin).
BRIDGE_USER=admin

# Port bridge. Ikuti alokasi yang disediakan panel Pterodactyl
# (contoh: 5013). App yang dikelola bridge memakai port internal 3101+,
# bukan port ini.
PORT=5013
